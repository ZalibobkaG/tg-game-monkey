# @BotFather -> /newbot
BOT_TOKEN=123456:AA...
# юзернейм бота без @ — нужен для deep-link и QR
BOT_USERNAME=obezyanka_game_bot

DATABASE_URL=postgres://obezyanka:obezyanka@localhost:5432/obezyanka

# polling (dev) | webhook (prod)
BOT_MODE=polling
# только для BOT_MODE=webhook
WEBHOOK_URL=https://example.com/tg
WEBHOOK_SECRET=change-me
PORT=3000

# trace | debug | info | warn | error
LOG_LEVEL=info

# пусто — ошибки только в логе; с DSN уходят ещё и в Sentry
SENTRY_DSN=

# ─── Мини-апп (Telegram Mini App) ─────────────────────────────────────────
# Публичный HTTPS-адрес страницы приложения. Пусто — мини-апп не поднимается
# вовсе: ни статики, ни API, ни кнопок в боте.
# Локально нужен туннель — http://localhost Telegram не открывает:
#   brew install cloudflared && cloudflared tunnel --url http://localhost:3000
# и сюда — выданный адрес с /app на конце.
WEBAPP_URL=

# Ставить ли кнопку «Играть» слева от поля ввода в чате с ботом.
WEBAPP_MENU_BUTTON=true

# Короткое имя приложения из @BotFather (/newapp) — нужно только для прямой
# ссылки t.me/<бот>/<приложение>. Кнопки в чате работают и без него.
WEBAPP_SHORT_NAME=

# Сколько секунд считать подпись initData действительной. Telegram подписывает
# её один раз при открытии, поэтому это срок сессии, а не окно от replay:
# пять минут выкинули бы всех, кто не закрыл приложение. По умолчанию сутки.
WEBAPP_INITDATA_TTL=86400

# ⚠️ Только для разработки. С этим tg_id API мини-аппа пускает запросы без
# подписи Telegram — чтобы верстать в обычном браузере. Работает лишь для
# запросов, пришедших на localhost, и никогда при NODE_ENV=production:
# туннель поднимают на той же машине, где верстают, и без этого ограничения
# публичный адрес пускал бы кого угодно под чужим tg_id.
WEBAPP_DEV_TG_ID=

# tg_id владельцев админ-панели через запятую (узнать свой: @userinfobot)
ADMIN_IDS=
# чат, куда падают обращения пользователей; пусто — уведомления уйдут в личку админам.
# id узнать так: добавить бота в чат и отправить там /chatid (команда только для админов).
# У супергрупп id вида -100xxxxxxxxxx. Если чат недоступен — обращения уйдут в личку.
ADMIN_CHAT_ID=

# ─── Оплата ───────────────────────────────────────────────────────────────
# Telegram Stars ключей не требуют — они работают на токене бота и включены
# по умолчанию. Правила Telegram (Bot Developers ToS, п. 6.2) разрешают
# продавать цифровые товары внутри бота ТОЛЬКО за Stars, поэтому всё
# остальное ниже выключено и предназначено для внешней витрины
# или физических товаров.

# Уровень лога платежей отдельно от общего: trace | debug | info | warn | error.
# Пусто — как LOG_LEVEL. На debug пишутся тела запросов к кассам и вебхуков
# (ключи и токены не логируются никогда). Весь путь денег помечен mod=pay:
#   npm run dev | grep '"mod":"pay"'
PAYMENTS_LOG_LEVEL=

# Секрет в пути вебхука касс: /pay/yookassa/<секрет>, /pay/crypto/<секрет>.
# Пусто — приём уведомлений не поднимается вовсе.
# Сгенерировать: openssl rand -hex 24
WEBHOOK_PATH_SECRET=

# ЮKassa: Личный кабинет -> Интеграция -> Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# куда вернуть человека после оплаты; пусто — ссылка на самого бота
YOOKASSA_RETURN_URL=
# ставка НДС для чека: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20%
YOOKASSA_VAT_CODE=1
# true — формировать чек по 54-ФЗ (нужна подключённая онлайн-касса)
YOOKASSA_SEND_RECEIPT=false

# Crypto Pay (@CryptoBot -> Crypto Pay -> Create App)
CRYPTO_PAY_TOKEN=
# mainnet | testnet
CRYPTO_PAY_NET=mainnet
CRYPTO_PAY_ASSET=USDT
