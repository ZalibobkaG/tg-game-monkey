# @BotFather -> /newbot
BOT_TOKEN=123456:AA...
# юзернейм бота без @ — нужен для deep-link и QR
BOT_USERNAME=obezyanka_game_bot

DATABASE_URL=postgres://obezyanka:obezyanka@localhost:5432/obezyanka

# polling (dev) | webhook (prod)
BOT_MODE=polling
# только для BOT_MODE=webhook
WEBHOOK_URL=https://example.com/tg
WEBHOOK_SECRET=change-me
PORT=3000

# trace | debug | info | warn | error
LOG_LEVEL=info

# пусто — ошибки только в логе; с DSN уходят ещё и в Sentry
SENTRY_DSN=

# tg_id владельцев админ-панели через запятую (узнать свой: @userinfobot)
ADMIN_IDS=
# чат, куда падают обращения пользователей; пусто — уведомления уйдут в личку админам.
# id узнать так: добавить бота в чат и отправить там /chatid (команда только для админов).
# У супергрупп id вида -100xxxxxxxxxx. Если чат недоступен — обращения уйдут в личку.
ADMIN_CHAT_ID=
